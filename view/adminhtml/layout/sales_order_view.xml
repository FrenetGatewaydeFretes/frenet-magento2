<?xml version="1.0"?>
<!--
  Frenet Shipping Gateway — Frenet box on the admin order view.
  -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Frenet_Shipping::css/labels.css"/>
    </head>
    <body>
        <referenceContainer name="order_additional_info">
            <block class="Magento\Backend\Block\Template" name="frenet.labels.order.panel"
                   template="Frenet_Shipping::labels/order-panel.phtml" aclResource="Frenet_Shipping::frenet">
                <arguments>
                    <argument name="view_model" xsi:type="object">Frenet\Shipping\ViewModel\Labels\OrderPanel</argument>
                    <argument name="common" xsi:type="object">Frenet\Shipping\ViewModel\Labels\Common</argument>
                </arguments>
            </block>
            <block class="Magento\Backend\Block\Template" name="frenet.tracking.order"
                   template="Frenet_Shipping::labels/order-tracking.phtml" after="frenet.labels.order.panel" aclResource="Frenet_Shipping::frenet">
                <arguments>
                    <argument name="view_model" xsi:type="object">Frenet\Shipping\ViewModel\Labels\OrderTracking</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
