<?php
/**
 * Frenet Shipping Gateway — shared header of the labels screens: brand strip (logo + wallet),
 * and "not configured" state.
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Frenet\Shipping\ViewModel\Labels\Common $common */
$common = $block->getData('common');
$wallet = $common->isAvailable() ? $common->wallet() : null;
?>
<header class="frenet-brand" role="banner">
    <div class="frenet-brand__id">
        <img class="frenet-brand__logo"
             src="<?= $escaper->escapeUrl($block->getViewFileUrl('Frenet_Shipping::images/frenet-logo.png')) ?>"
             alt="Frenet" width="96" height="40"/>
        <span class="frenet-brand__tag"><?= $escaper->escapeHtml(__('Shipping management')) ?></span>
    </div>
    <?php if ($common->isAvailable()): ?>
        <div class="frenet-brand__wallet">
            <span class="frenet-brand__label"><?= $escaper->escapeHtml(__('Frenet wallet balance')) ?></span>
            <strong class="frenet-brand__value"
                    data-frenet-balance="<?= $wallet
                        ? $escaper->escapeHtmlAttr((string) $wallet['balance'])
                        : '' ?>">
                <?= $wallet
                    ? $escaper->escapeHtml($common->money($wallet['balance']))
                    : $escaper->escapeHtml(__('Unavailable')) ?>
            </strong>
            <?php if ($wallet): ?>
                <span class="frenet-brand__meta"><?= $escaper->escapeHtml(__(
                    '%1 labels available',
                    $wallet['labels']
                )) ?></span>
            <?php endif; ?>
            <!-- Balance is added through the Frenet panel's own payment gateway (v1); back here, read it again. -->
            <form class="frenet-brand__refill"
                  method="post"
                  action="<?= $escaper->escapeUrl($block->getUrl('frenetshipping/wallet/refresh')) ?>">
                <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
                <a class="frenet-brand__cta"
                   href="<?= $escaper->escapeUrl($common->panelUrl()) ?>"
                   target="_blank"
                   rel="noopener noreferrer"><?= $escaper->escapeHtml(__('Add balance in the Frenet panel')) ?></a>
                <button type="submit" class="frenet-brand__link"><?= $escaper->escapeHtml(__(
                    'Update balance'
                )) ?></button>
            </form>
        </div>
    <?php endif; ?>
</header>
<?php if (!$common->isAvailable() && !$block->getData('works_without_labels')): ?>
    <div class="frenet-empty">
        <h2><?= $escaper->escapeHtml(__('Connect your Frenet partner token')) ?></h2>
        <p><?= $escaper->escapeHtml(__(
            'Creating labels from the store is exclusive to Frenet customers with the whitelabel service active. '
            . 'Each of them has its own partner token (x-partner-token): turn on "Labels" in the Frenet Shipping '
            . 'settings and paste it there.'
        )) ?></p>
        <p><?= $escaper->escapeHtml(__(
            'Do not have the whitelabel service? Talk to Frenet to activate it. '
            . 'Quotes and tracking keep working without it.'
        )) ?></p>
        <a class="action-primary"
           href="<?= $escaper->escapeUrl($common->settingsUrl()) ?>"><span><?= $escaper->escapeHtml(__(
               'Open settings'
           )) ?></span></a>
    </div>
<?php endif; ?>
