?>
<div class="frenet-labels">
<?= /* @noEscape */ $block->fetchView($block->getTemplateFile('Frenet_Shipping::labels/header.phtml')) ?>
    <div class="frenet-empty">
        <span class="frenet-pill frenet-pill--wait"><?= $escaper->escapeHtml(__('Coming soon')) ?></span>
        <h2><?= $escaper->escapeHtml($title) ?></h2>
        <p><?= $escaper->escapeHtml($text) ?></p>
        <a class="action-default" href="<?= $escaper->escapeUrl($block->getUrl('frenetshipping/shipment/index')) ?>"><?= $escaper->escapeHtml(__('Back to Create shipment')) ?></a>
    </div>
</div>
