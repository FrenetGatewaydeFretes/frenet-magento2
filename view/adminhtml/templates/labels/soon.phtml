<?php
/**
 * Frenet Shipping Gateway — placeholder of features that are coming (WhatsApp, returns, proof, control tower).
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
$features = [
    'whatsapp' => [__('WhatsApp'), __('Send the tracking of each order to the customer by WhatsApp.')],
    'reverse' => [__('Returns (reverse logistics)'), __('Create the return label of an order and follow it until it arrives.')],
    'receipt' => [__('Proof of delivery'), __('See and download the proof that the package was delivered.')],
    'tower' => [__('Control tower'), __('All your shipments in one panel: delays, problems and what needs attention.')],
];
