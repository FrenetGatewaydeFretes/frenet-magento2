<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <group id="product_quote" translate="label" type="text" sortOrder="210" showInDefault="1" showInWebsite="1" showInStore="1">
        <label>Product Quote</label>
        <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Enabled</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <comment>If enabled the product shipping quote will be possible from product page.</comment>
        </field>
        <field id="product_types" translate="label" type="multiselect" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Enable for Product Types</label>
            <source_model>Frenet\Shipping\Model\Config\Source\Catalog\Product\Quote\ProductTypes</source_model>
            <comment>These are the product types allowed to be quote in the product page.</comment>
            <depends>
                <field id="enabled">1</field>
            </depends>
        </field>
        <field id="visitor_limit" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
            <label>Quote Limit per Visitor (per minute)</label>
            <validate>validate-digits</validate>
            <comment><![CDATA[Maximum product page quotes a single visitor can request per minute. Protects your Frenet API quota from abuse. Default: 60. Use 0 for no limit.]]></comment>
            <depends>
                <field id="enabled">1</field>
            </depends>
        </field>
        <field id="store_limit" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
            <label>Quote Limit per Store (per minute)</label>
            <validate>validate-digits</validate>
            <comment><![CDATA[Maximum product page quotes all visitors of this website can request per minute together. Stops floods that come from many addresses. Cart and checkout quotes are never limited. Default: 1000. Use 0 for no limit.]]></comment>
            <depends>
                <field id="enabled">1</field>
            </depends>
        </field>
    </group>
</include>
