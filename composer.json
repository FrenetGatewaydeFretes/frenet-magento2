{
    "name": "frenet/frenet-magento2",
    "type": "magento2-module",
    "version": "2.4.9.2",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Frenet\\Shipping\\": ""
        }
    },
    "description":"Integrate your Magento 2 with Frenet Services in a simple way.",
    "repositories": [
        {
            "name": "mage-os",
            "type": "composer",
            "url": "https://mirror.mage-os.org/"
        },
        {
            "name": "packagist",
            "type": "composer",
            "url": "https://packagist.org"
        }
    ],
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "frenet/frenet-php": "^1.3.4",
        "symfony/finder": "^6.4||^7.0",
        "magento/framework": "^103.0.0|^104.0.0",
        "magento/module-catalog": "^101.0.0|^102.0.0|^103.0.0|^104.0.0",
        "magento/module-catalog-inventory": "^100.0.0",
        "magento/module-quote": "^101.0.0|^102.0.0|^103.0.0|^104.0.0",
        "magento/module-checkout": "^100.0.0",
        "magento/module-sales": "^102.0.0|^103.0.0",
        "magento/module-shipping": "^100.0.0",
        "magento/module-directory": "^100.0.0",
        "magento/module-bundle": "^101.0.0|^102.0.0|^103.0.0|^104.0.0",
        "magento/module-grouped-product": "^100.0.0",
        "magento/module-configurable-product": "^100.0.0",
        "magento/module-downloadable": "^100.0.0",
        "magento/module-store": "^101.0.0",
        "magento/module-config": "^101.0.0",
        "magento/module-eav": "^102.0.0",
        "magento/module-ui": "^101.0.0"
    },
    "require-dev": {
        "magento/magento-coding-standard": ">=4",
        "bitexpert/phpstan-magento": "^0.44",
        "phpmd/phpmd": "@stable",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "license": "proprietary",
    "suggest": {},
    "authors": [
        {
            "name": "Tiago Sampaio",
            "email": "tiago@tiagosampaio.com",
            "homepage": "http://tiagosampaio.com",
            "role": "Magento Architect"
        }
    ],
    "support": {
        "email": "contato@frenet.com.br"
    },
    "minimum-stability": "stable",
    "scripts": {
        "tests": [
            "@coding-standard",
            "@phpunit"
        ],
        "coding-standard": [
            "@phpcs",
            "@php-compatibility",
            "@phpmd",
            "@phpstan"
        ],
        "phpunit": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "phpmd": "vendor/bin/phpmd Api/,Block/,Controller/,Model/,Service/,Setup/,ViewModel/ text cleancode,codesize,controversial,design,naming,unusedcode",
        "phpcs": "vendor/bin/phpcs --extensions=php,phtml Api Block Controller Model Service Setup Test ViewModel view registration.php",
        "php-compatibility": "vendor/bin/phpcs --standard=PHPCompatibility --runtime-set testVersion 8.3- --extensions=php Api Block Controller Model Service Setup Test ViewModel registration.php"
    },
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "magento/magento-composer-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true
        }
    }
}
